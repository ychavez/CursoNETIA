{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;api",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Database": "Data Source=AulaPedidos.db"
  },
  "Jwt": {
    "DemoMode": false
  },
  "Notifications": {
    "BaseUrl": "http://localhost:5099/"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 5
  }
}